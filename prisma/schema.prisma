generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Multi-tenant: oricine se poate înregistra și are propriul cont, izolat
// (fiecare instructor își vede doar clienții lui — deja garantat de relații).
model Instructor {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  active        Boolean  @default(true)  // dezactivat de superadmin = nu se mai poate loga
  isSuperAdmin  Boolean  @default(false) // contul creat prin /api/setup, administrează platforma
  createdAt     DateTime @default(now())
  clients       Client[]
  templates     Template[]
  programs      Program[]
  announcements Announcement[]
}

model Client {
  id              String    @id @default(cuid())
  instructorId    String
  instructor      Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  name            String
  phone           String?
  active          Boolean   @default(true)
  inviteHash      String?   @unique
  inviteExpiresAt DateTime?
  createdAt       DateTime  @default(now())
  sessions        ClientSession[]
  entries         Entry[]
  messages        Message[]
  measurements    Measurement[]
  habitLogs       HabitLog[]
  checkIns        CheckIn[]
  intake          Intake?
  programs        Program[]
  reminders       Reminder[]
  notes           ClientNote[]
  progressRecords ProgressRecord[]
  nutritionGoals  NutritionGoal[]

  // Ținte zilnice de nutriție (grame / kcal), setate de instructor.
  dailyProteinTarget  Int?
  dailyCarbsTarget    Int?
  dailyFatTarget      Int?
  dailyCaloriesTarget Int?

  @@index([instructorId])
}

model ClientSession {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime

  @@index([clientId])
}

model Entry {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind         String   // NUTRITION sau WORKOUT — validat la intrarea în API
  date         String   // YYYY-MM-DD
  time         String   // HH:mm
  title        String
  details      String
  muscleGroup  String?  // doar pentru WORKOUT — Piept, Spate, Picioare etc.
  protein      Int?     // doar pentru NUTRITION — grame
  carbs        Int?     // doar pentru NUTRITION — grame
  fat          Int?     // doar pentru NUTRITION — grame
  calories     Int?     // doar pentru NUTRITION — kcal
  completed    Boolean  @default(false)
  feedback     String   @default("")   // observația clientului
  coachNote    String   @default("")   // răspunsul/corectura instructorului — vizibil clientului pe acest exercițiu/masă
  version      Int      @default(1)
  updatedAt    DateTime @updatedAt

  @@index([clientId, date])
}

// Formular de anamneză, completat o dată de client la început (editabil ulterior).
model Intake {
  id              String   @id @default(cuid())
  clientId        String   @unique
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  medicalHistory  String   @default("")
  injuries        String   @default("")
  experienceLevel String   @default("") // ÎNCEPĂTOR / INTERMEDIAR / AVANSAT
  lifestyle       String   @default("")
  foodPreferences String   @default("")
  goals           String   @default("")
  updatedAt       DateTime @updatedAt
}

// Măsurători corporale în timp — fără fotografii, doar numere (progresul vizual
// se discută la apelul video).
model Measurement {
  id       String   @id @default(cuid())
  clientId String
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date     String   // YYYY-MM-DD
  weight   Float?   // kg
  waist    Float?   // cm
  hips     Float?   // cm
  arms     Float?   // cm
  thighs   Float?   // cm
  notes    String   @default("")

  @@index([clientId, date])
}

// Obiceiuri zilnice bifabile de client — apă, pași, somn.
model HabitLog {
  id         String @id @default(cuid())
  clientId   String
  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date       String // YYYY-MM-DD
  waterMl    Int?
  steps      Int?
  sleepHours Float?

  @@unique([clientId, date])
}

// Check-in săptămânal — completat de client, de regulă vineri/sâmbătă.
model CheckIn {
  id                  String   @id @default(cuid())
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  weekOf              String   // YYYY-MM-DD — luni săptămânii respective
  avgWeight           Float?
  energyLevel         Int?     // 1-5
  dietAdherencePercent Int?    // 0-100
  difficulties        String   @default("")
  createdAt           DateTime @default(now())

  @@unique([clientId, weekOf])
}

// Șabloane proprii salvate de instructor (planuri de antrenament sau zile de
// nutriție reutilizabile), pe lângă exemplele predefinite din lib/templates.ts.
model Template {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  kind         String     // WORKOUT sau NUTRITION
  name         String
  data         Json       // structura WorkoutProgram sau NutritionDay din lib/templates.ts
  createdAt    DateTime   @default(now())

  @@index([instructorId, kind])
}

model Message {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sender    String   // INSTRUCTOR sau CLIENT
  text      String
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

// Program reutilizabil sau atribuit unui client. Structura builder-ului (săptămâni,
// zile, exerciții și serii) este păstrată în JSON pentru editare rapidă și versionare.
model Program {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  description  String     @default("")
  kind         String     @default("WORKOUT")
  status       String     @default("DRAFT")
  data         Json
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([instructorId, kind])
  @@index([clientId])
}

model Reminder {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      String
  title     String
  details   String   @default("")
  time      String   @default("09:00")
  days      String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([clientId, active])
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, updatedAt])
}

model ProgressRecord {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exerciseName String
  date         String
  weight       Float?
  reps         Int?
  source       String   @default("MANUAL")
  notes        String   @default("")
  createdAt    DateTime @default(now())

  @@index([clientId, exerciseName, date])
}

model NutritionGoal {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  startDate      String
  calories       Int
  proteinPercent Int      @default(30)
  fatPercent     Int      @default(30)
  carbsPercent   Int      @default(40)
  saturatedFat   Int?
  cholesterol    Int?
  fibers         Int?
  sugars         Int?
  sodium         Int?
  days           String   @default("1,2,3,4,5,6,0")
  repeatWeeks    Int      @default(1)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([clientId, active])
}

model Announcement {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  title        String
  content      String
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@index([instructorId, active])
}
