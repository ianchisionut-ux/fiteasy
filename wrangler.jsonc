{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fiteasy",
  "workers_dev": true,
  "main": "./cloudflare-worker.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  }
}
